Screen {
    background: $surface;
}

#body {
    height: 1fr;
}

#controls {
    height: 4;
    padding: 0 1;
    align: left middle;
}

#level-select {
    width: 18;
    margin-bottom: 1;
}

#time-filter {
    width: 14;
    margin-left: 1;
    margin-bottom: 1;
}

#status {
    width: 1fr;
    content-align: right middle;
}

#main-content {
    height: 1fr;
}

#source-pane {
    width: 20%;
    border-right: solid $panel;
}

#log-pane {
    width: 1fr;
    layers: content splash;
}

#log-title,
#log-viewer {
    layer: content;
}

#splash {
    position: absolute;
    layer: splash;
    width: 100%;
    height: 100%;
    offset: 0 0;
    content-align: center middle;
    background: $surface;
    color: $foreground 80%;
}

.pane-title {
    height: 1;
    padding: 0 1;
    text-style: bold;
}

HelpScreen {
    align: center middle;
    background: $background 80%;
}

#help-dialog {
    width: 62;
    height: auto;
    padding: 1 2;
    border: solid $panel;
    background: $surface;
}

#help-title {
    text-style: bold;
    margin-bottom: 1;
}

#close-help {
    margin-top: 1;
    width: 12;
}

TimeFilterScreen {
    align: center middle;
    background: $background 80%;
}

#time-filter-dialog {
    width: 58;
    height: auto;
    padding: 1 2;
    border: solid $panel;
    background: $surface;
}

#time-filter-title {
    text-style: bold;
    margin-bottom: 1;
}

#time-filter-instructions {
    margin-bottom: 1;
}

#time-date-row,
#time-of-day-row {
    height: 3;
    align: left middle;
}

#time-date-row Static,
#time-of-day-row Static {
    width: 18;
}

#time-date-row Input,
#time-of-day-row Input {
    width: 1fr;
}

#time-window-controls {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#time-window-controls Static {
    width: 18;
}

#time-window-controls Input {
    width: 8;
    margin: 0 1;
}

#time-window-controls Button {
    width: 5;
}

#time-filter-error {
    color: $error;
    height: 2;
}

#time-filter-actions {
    height: 3;
    align: right middle;
}

#time-filter-actions Button {
    margin-left: 1;
}

AddSourceScreen {
    align: center middle;
    background: $background 80%;
}

#add-source-dialog {
    width: 72;
    height: 80%;
    min-height: 18;
    padding: 1 2;
    border: solid $panel;
    background: $surface;
}

#add-source-title {
    text-style: bold;
}

#add-source-instructions {
    margin-bottom: 1;
}

#add-source-tree {
    height: 1fr;
    border: solid $panel;
}

#add-source-selection {
    height: 2;
    padding: 1 0 0 0;
}

#add-source-name {
    display: none;
    margin-bottom: 1;
}

#add-source-actions {
    height: 3;
    align: right middle;
}

#add-source-actions Button {
    margin-left: 1;
}

RenameSourceScreen {
    align: center middle;
    background: $background 80%;
}

#rename-source-dialog {
    width: 52;
    height: auto;
    padding: 1 2;
    border: solid $panel;
    background: $surface;
}

#rename-source-title {
    text-style: bold;
    margin-bottom: 1;
}

#rename-source-actions {
    height: 3;
    align: right middle;
}

#rename-source-actions Button {
    margin-left: 1;
}
